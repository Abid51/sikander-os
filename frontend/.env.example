# Sikander OS dashboard — copy to `.env` in this folder for local overrides:
#   copy .env.example .env   (Windows PowerShell: Copy-Item .env.example .env)

# Backend base URL (baked into production build when set).
VITE_API_URL=http://127.0.0.1:8000

# Voice orb — Web Speech recognition + TTS language (BCP-47).
# Examples: en-US | ur-PK | hi-IN
VITE_VOICE_LANG=ur-PK
