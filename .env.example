# ════════════════════════════════════════════════════════════
#  Sikander OS / IGRIS — Environment Configuration Template
#  Copy this file to `.env` and fill in the keys you want.
#  You do NOT need all providers — leave empty ones blank.
# ════════════════════════════════════════════════════════════

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# CLOUD / API LLM PROVIDERS  (optional — pick any)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Groq — fastest inference, free tier.   https://console.groq.com/keys
GROQ_API_KEY=

# OpenAI (GPT-4o, GPT-4.1, GPT-3.5).     https://platform.openai.com
OPENAI_API_KEY=

# Anthropic Claude.                       https://console.anthropic.com
ANTHROPIC_API_KEY=

# Google Gemini (free tier available).   https://aistudio.google.com
GEMINI_API_KEY=

# Mistral AI.                             https://console.mistral.ai
MISTRAL_API_KEY=

# Together AI (open models).             https://api.together.xyz
TOGETHER_API_KEY=

# OpenRouter (gateway to 200+ models).   https://openrouter.ai
OPENROUTER_API_KEY=

# Perplexity (online search models).     https://www.perplexity.ai
PERPLEXITY_API_KEY=

# HuggingFace Inference.                 https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
# Alias (some clients use this name)
HF_API_KEY=

# Replicate (image/video/audio models).  https://replicate.com/account/api-tokens
REPLICATE_API_KEY=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# LOCAL LLAMA / OLLAMA  (runs on your machine)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Install: https://ollama.com   Then:  ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# DATABASE
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
DATABASE_URL=sqlite:///./igris.db
DATABASE_ECHO=false

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# SECURITY
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRY=3600
REFRESH_TOKEN_EXPIRY=604800

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# API CONFIGURATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
API_PORT=8000
API_HOST=0.0.0.0
LOG_LEVEL=INFO

# Front-end base URL — used by docker-compose when building the web image
VITE_API_URL=http://127.0.0.1:8000

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# MONITORING / TELEMETRY
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
ENABLE_MONITORING=true
ENABLE_ANALYTICS=true
METRICS_INTERVAL=60

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# VOICE CONTROL
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
VOICE_AUTO_MODE=true
VOICE_CONFIDENCE_THRESHOLD=0.7
VOICE_LANGUAGES=ur-PK,en-US

# ════════════════════════════════════════════════════════════
# HOW TO USE
# ════════════════════════════════════════════════════════════
#   1. cp .env.example .env
#   2. Fill in at least ONE provider key OR install Ollama locally
#   3. python main.py      (or:  docker compose up)
# ════════════════════════════════════════════════════════════
