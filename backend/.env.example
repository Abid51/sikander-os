# Safe default for local runs (override in real deployments)
IGRIS_ENV=development

# Optional: require Bearer / X-IGRIS-Token on non-exempt routes
# IGRIS_API_TOKEN=your-secret-token
# Production safety mode (prod/production enables auth fail-fast checks)
# IGRIS_ALLOW_OPEN_AUTH=false
# Comma-separated path prefixes that skip auth (defaults include /docs, /chat, /observability/snapshot)
# IGRIS_AUTH_EXEMPT=/docs,/openapi.json,/chat,/chat/stream
# Comma-separated frontend origins; empty in development uses localhost defaults
# IGRIS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5173
# Runtime tool generation by LLM (unsafe in most cases). Keep disabled by default.
# IGRIS_ENABLE_TOOL_FORGE=false
# Vision mode: live (prefer live full-screen buffer) | snapshot (fallback capture)
# IGRIS_VISION_MODE=live
# Force chat to prefer direct LLM response (skip reflex/tool auto-actions)
# IGRIS_FORCE_LLM_CHAT=true
# Enforce strict per-tool argument validation before execution
# IGRIS_STRICT_TOOL_ARGS=true
# Enable intent router: allow tools only on action-like prompts
# IGRIS_ENABLE_ACTION_ROUTER=true
# Require explicit approval for high-risk tool categories
# IGRIS_STRICT_APPROVAL=true
# Tool result verbosity: short | medium | detailed
# IGRIS_TOOL_RESULT_STYLE=short
# Enforce real action evidence; block fake "done" replies without tool execution
# IGRIS_ENFORCE_REAL_ACTIONS=true
# How Igris should address you (comma-separated, first one preferred)
# IGRIS_USER_TITLES=My King,Boss,Sir

# Comma-separated absolute folders the file manager may access (default: process cwd)
# IGRIS_ALLOWED_FILE_ROOTS=C:\Users\You\workspace,C:\Projects\sikander-os
